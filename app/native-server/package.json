{
  "name": "aieasybrowser-bridge",
  "version": "0.1.0",
  "description": "AIEasyBrowser Native Messaging bridge",
  "main": "dist/index.js",
  "bin": {
    "aieasybrowser": "./dist/cli.js",
    "aieasybrowser-bridge": "./dist/cli.js"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js,json --ignore dist/ --exec \"npm run build && npm run register:dev\"",
    "build": "ts-node src/scripts/build.ts",
    "test": "jest",
    "test:coverage": "cross-env JEST_COVERAGE=1 jest --coverage",
    "test:watch": "jest --watch",
    "test:cli-regression": "pnpm --filter aieasybrowser-shared build && pnpm run build && node src/scripts/cli-regression.cjs",
    "lint": "eslint 'src/**/*.{js,ts}'",
    "lint:fix": "eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "register:dev": "node dist/scripts/register-dev.js"
  },
  "files": [
    "dist",
    "!dist/node_path.txt"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "preferGlobal": true,
  "keywords": [
    "cli",
    "agent",
    "chrome",
    "browser"
  ],
  "author": "AIEasyBrowser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aieasybrowser/aieasybrowser.git",
    "directory": "app/native-server"
  },
  "homepage": "https://github.com/aieasybrowser/aieasybrowser",
  "bugs": {
    "url": "https://github.com/aieasybrowser/aieasybrowser/issues"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@types/node-fetch": "2",
    "chalk": "^5.4.1",
    "chrome-devtools-frontend": "^1.0.1299282",
    "aieasybrowser-shared": "workspace:*",
    "ajv": "8.20.0",
    "commander": "^13.1.0",
    "fastify": "^5.3.2",
    "node-fetch": "2",
    "pino": "^9.6.0",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/chrome": "^0.0.318",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/parser": "^8.31.1",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
