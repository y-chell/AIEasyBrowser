{
  "name": "aieasybrowser",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "author": "AIEasyBrowser",
  "repository": {
    "type": "git",
    "url": "https://github.com/aieasybrowser/aieasybrowser.git"
  },
  "homepage": "https://github.com/aieasybrowser/aieasybrowser",
  "bugs": {
    "url": "https://github.com/aieasybrowser/aieasybrowser/issues"
  },
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter aieasybrowser-shared build",
    "build:native": "pnpm --filter aieasybrowser-bridge build",
    "build:extension": "pnpm --filter aieasybrowser-extension build",
    "build": "pnpm run build:shared && pnpm run build:native && pnpm run build:extension",
    "dev:shared": "pnpm --filter aieasybrowser-shared dev",
    "dev:native": "pnpm --filter aieasybrowser-bridge dev",
    "dev:extension": "pnpm --filter aieasybrowser-extension dev",
    "dev": "pnpm --filter aieasybrowser-shared build && pnpm -r --parallel dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm -r format",
    "clean:dist": "pnpm -r exec rm -rf dist .turbo",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean": "npm run clean:dist && npm run clean:modules",
    "typecheck": "pnpm run build:shared && pnpm run typecheck:shared && pnpm run typecheck:native && pnpm run typecheck:extension",
    "typecheck:shared": "pnpm --filter aieasybrowser-shared exec tsc --noEmit --pretty false",
    "typecheck:native": "pnpm --filter aieasybrowser-bridge exec tsc --noEmit --pretty false",
    "typecheck:extension": "pnpm --filter aieasybrowser-extension exec tsc --noEmit --pretty false",
    "test": "pnpm run build:shared && pnpm --filter aieasybrowser-bridge exec jest --runInBand && pnpm --filter aieasybrowser-extension test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.25.1",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vue-eslint-parser": "^10.1.3"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
